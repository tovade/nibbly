{
    "name": "backend",
    "module": "src/index.ts",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "bun run --watch src/index.ts",
        "start": "bun run src/index.ts",
        "build": "bun build src/index.ts --outdir dist --target node",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@types/bun": "^1.3.5",
        "@types/node": "^25.0.3",
        "dotenv": "^17.2.3",
        "drizzle-kit": "^0.31.8",
        "prettier": "3.7.4",
        "tsx": "^4.21.0"
    },
    "peerDependencies": {
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@elysiajs/cors": "^1.4.0",
        "@elysiajs/node": "^1.4.2",
        "better-auth": "^1.4.7",
        "drizzle-orm": "^0.45.1",
        "elysia": "^1.4.19",
        "pg": "^8.16.3",
        "pino": "^10.1.0"
    }
}
